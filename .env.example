# Copia este archivo a .env y completa. El .env NUNCA va a git.

# Dominios que apuntan a la IP del servidor (registros A en tu DNS)
API_DOMINIO=widget.tudominio.com
N8N_DOMINIO=n8n.tudominio.com
PUBLIC_URL=https://widget.tudominio.com

# Cifra los tokens de Kommo guardados en la base. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la pierdes, hay que volver a conectar cada cuenta.
TOKEN_KEY=

# Contraseña de Postgres (larga y aleatoria)
POSTGRES_PASSWORD=

# Clave que n8n manda en la cabecera X-Interno para leer /v1/interno/leads
INTERNAL_KEY=

# Clave de cifrado de n8n. No cambiarla después: n8n dejaría de arrancar.
N8N_ENCRYPTION_KEY=
